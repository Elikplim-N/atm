JWT_SECRET=change-this-in-production
PUBLIC_WEB_URL=http://localhost:5173

# PostgreSQL connection string. The app will not start without this set.
DATABASE_URL=postgresql://user:password@host:5432/database

# --- Optional ---

# Only used by the local dev server (src/index.js); Vercel ignores it.
PORT=4000

# Restrict CORS to the deployed client's origin. Omit for local dev (permissive).
CORS_ORIGIN=https://your-client-project.vercel.app

# Set to "true" if your Postgres provider requires TLS (e.g. most managed
# services). A self-hosted VPS Postgres usually doesn't — leave unset/false.
DATABASE_SSL=false

# Max connections per pool instance. Keep this low for serverless deployments
# (many function instances can each hold a pool) against a small database.
DB_POOL_MAX=3
