JWT_SECRET=change-this-in-production
PUBLIC_WEB_URL=http://localhost:5173

# PostgreSQL connection string. The app will not start without this set.
DATABASE_URL=postgresql://user:password@host:5432/database

# --- Optional ---

# Only used by the local dev server (src/index.js); Vercel ignores it.
PORT=4000

# Restrict CORS to the deployed client's origin. Omit for local dev (permissive).
CORS_ORIGIN=https://your-client-project.vercel.app

# Set to "true" if your Postgres provider requires TLS (e.g. most managed
# services). A self-hosted VPS Postgres usually doesn't — leave unset/false.
DATABASE_SSL=false

# Max connections per pool instance. Keep this low for serverless deployments
# (many function instances can each hold a pool) against a small database.
DB_POOL_MAX=3

# Arkesel (https://arkesel.com) SMS API key, used to send real SMS: the
# thank-you confirmation after a customer submits feedback (web, USSD, or
# the SMS channel) with a phone number, and the "Send SMS alert to
# management" button on the dashboard. Without it, sends are skipped (logged
# only) rather than failing the request. Rotate this if it's ever been
# shared anywhere outside a secrets manager.
ARKESEL_API_KEY=

# Sender ID shown on outgoing SMS. Must be a sender ID already registered
# and approved with Arkesel — an unapproved one will be rejected.
ARKESEL_SENDER_ID=GCB

# Comma-separated phone numbers (Ghana local "0XX..." or "+233..." both
# work) that receive the SMS alert when management clicks "Send SMS alert
# to management" for underperforming ATMs.
ALERT_PHONE_NUMBERS=
